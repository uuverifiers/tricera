#!/bin/sh

TESTS="get-1.c  \
       incdec-1.c  \
       incdec-2.c  \
       max-1.c  \
       max-2.c  \
       multadd-1.c  \
       truck-2.c  \
       heapptr-to-stackptr.c \
       qualified-heapptr-to-stackptr.c \
       multi-arg-1.c multi-arg-2.c \
       alias-share-safe.c alias-share-unsafe.c \
       alias-reject-overlap.c alias-reject-array.c alias-reject-deref.c"

for name in $TESTS; do
    echo
    echo $name
    $TRI_CMD -cex -acsl "$@" $name 2>&1 | grep -v 'at '
done

TESTS="struct-field-read.c enum-indexed-struct.c enum-indexed-struct-field.c"
for name in $TESTS; do
    echo
    echo $name
    $TRI_CMD -cex -acsl -m:entry "$@" $name 2>&1 | grep -v 'at '
done

TESTS="global-array-increment-safe.c \
       global-array-offset.c \
       global-array-call-aliases.c \
       global-array-increment-unsafe.c \
       global-array-pointer-alias-unsafe.c \
       global-array-pointer-reassign-safe.c"

for heap in native array; do
    for name in $TESTS; do
        echo
        echo "$name ($heap)"
        $TRI_CMD "$@" -assertNoVerify -acsl -forceNondetInit -heapModel:$heap -m:main $name 2>&1 | grep -v 'at '
    done

    # Check that concrete initial values survive in the precondition too.
    echo
    echo "global-array-offset.c ($heap, initialized)"
    $TRI_CMD "$@" -solutionReconstruction:cegar -assertNoVerify -acsl -heapModel:$heap -m:main global-array-offset.c 2>&1 | grep -v 'at '
done
