#!/bin/sh



TESTS="nonlinear2.hcc \
       ../horn-hcc/loop1.hcc \
       ../horn-hcc/loop2.hcc \
       bitwise1.hcc \
       bitwise2.hcc"

for name in $TESTS; do
    echo
    echo $name
    # Clause verification can exhaust memory or time depending on the platform.
    # Keep the warning and result, but normalize the resource-limit diagnostic.
    $TRI_CMD -cex -abstract:off -arithMode:ilp32 "$@" $name 2>&1 | grep -v 'at ' |
        sed -e 's/^Warning: Timeout while verifying clause:$/Warning: Verification of clause was not possible:/' \
            -e '/^Checker said: OutOfMemory$/d'
done

echo
echo MonadicInv.hcc
$TRI_CMD -arithMode:ilp32 "$@" MonadicInv.hcc 2>&1

echo
echo bitwise3.hcc
$TRI_CMD -arithMode:ilp32 "$@" bitwise3.hcc 2>&1

TESTS="assign-conv-unsafe.c arg-conv-unsafe.c return-conv-unsafe.c \
       struct-init-conv-unsafe.c unsigned-wrap-safe.c"

for name in $TESTS; do
    echo
    echo $name
    $TRI_CMD -arithMode:ilp32 "$@" $name 2>&1 | grep -E '^(SAFE|UNSAFE)$'
done

TESTS="bool-init-and-store-from-int-safe.c bool-init-and-store-from-int-unsafe.c \
       bool-truth-test-safe.c bool-truth-test-unsafe.c \
       bool-promotion-safe.c bool-promotion-unsafe.c \
       bool-int-casts-safe.c bool-int-casts-unsafe.c \
       bool-struct-field-safe.c bool-struct-field-unsafe.c \
       bool-heap-and-array-write-safe.c bool-heap-and-array-write-unsafe.c \
       bool-call-arg-and-return-safe.c bool-call-arg-and-return-unsafe.c \
       bool-nondet-range-safe.c bool-nondet-range-unsafe.c \
       bool-from-pointer-init-safe.c bool-from-pointer-init-unsafe.c \
       bool-from-pointer-store-safe.c bool-from-pointer-store-unsafe.c \
       bool-from-pointer-cast-safe.c bool-from-pointer-cast-unsafe.c"

for name in $TESTS; do
    for mode in math ilp32; do
        echo
        echo "$name ($mode)"
        $TRI_CMD -arithMode:$mode "$@" $name 2>&1 | grep -E '^(SAFE|UNSAFE)$'
    done
done

TESTS="uchar-promotion-safe.c uchar-promotion-unsafe.c \
       char-short-sizeof-safe.c char-short-sizeof-unsafe.c \
       uchar-heap-array-safe.c uchar-heap-array-unsafe.c \
       char-short-struct-field-safe.c char-short-struct-field-unsafe.c \
       uchar-ushort-decrement-safe.c uchar-ushort-decrement-unsafe.c \
       complement-safe.c complement-unsafe.c \
       literal-hex-unsigned-safe.c literal-hex-unsigned-unsafe.c \
       literal-unsigned-suffix-safe.c literal-unsigned-suffix-unsafe.c"

for name in $TESTS; do
    for mode in math ilp32; do
        echo
        echo "$name ($mode)"
        $TRI_CMD -arithMode:$mode "$@" $name 2>&1 | grep -E '^(SAFE|UNSAFE)$'
    done
