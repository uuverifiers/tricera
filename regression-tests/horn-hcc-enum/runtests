#!/bin/sh



TESTS="enum1.hcc \
       enum1-trailing-comma.hcc \
       enum2.hcc \
       enum3.hcc \
       enum4.hcc \
       enum-typedef.hcc \
       enum-typedef2.hcc \
       enum-typedef-pointer.hcc \
       enum-typedef-pointer2.hcc \
       enum-typedef-bug-1.hcc \
       enum-typedef-bug-2.hcc"

for name in $TESTS; do
    echo
    echo $name
    $TRI_CMD -cex -abstract:off "$@" $name 2>&1 | grep -v 'at '
done

TESTS="enum-cast-unsigned.hcc enum-cast-unsigned-unsafe.hcc"

for name in $TESTS; do
    echo
    echo $name
    $TRI_CMD -abstract:off "$@" $name 2>&1 | grep -E 'SAFE|UNSAFE'
done

TESTS="enum-negative-safe.c enum-negative-unsafe.c \
       enum-arithmetic-safe.c enum-arithmetic-unsafe.c"

for mode in math ilp32; do
    for name in $TESTS; do
        echo
        echo "$name ($mode)"
        $TRI_CMD -abstract:off "$@" -arithMode:$mode $name 2>&1 | grep -E '^(SAFE|UNSAFE)$'
    done
done

TESTS="enum-wrap-value-safe.c enum-wrap-value-unsafe.c \
       enum-wrap-next-safe.c enum-wrap-next-unsafe.c \
       enum-widen-safe.c enum-widen-unsafe.c \
       enum-truncating-cast-and-compound-assign-safe.c \
       enum-truncating-cast-and-compound-assign-unsafe.c \
       enum-unsigned-underlying-range-safe.c \
       enum-unsigned-underlying-range-unsafe.c \
       enum-struct-array-field-safe.c enum-struct-array-field-unsafe.c \
       enum-pointer-as-underlying-type-safe.c \
       enum-pointer-as-underlying-type-unsafe.c \
       enum-assign-big-switch-safe.c enum-assign-big-switch-unsafe.c \
       enum-assign-negative-to-unsigned-safe.c \
       enum-assign-negative-to-unsigned-unsafe.c"

for name in $TESTS; do
    echo
    echo "$name (ilp32)"
    $TRI_CMD -abstract:off "$@" -arithMode:ilp32 $name 2>&1 | grep -E '^(SAFE|UNSAFE)$'
done
