#!/bin/sh



TESTS="atomic3e.hcc atomic3f.hcc \
       clocks1.hcc clocks2.hcc clocks3.hcc clocks4.hcc clocks5.hcc \
       fischer.hcc lazy-and-or-bug.hcc \
       channels.hcc channels-2.hcc channels-2b.hcc channels-3.hcc \
       duration1.hcc duration2.hcc \
       duration3.hcc duration3b.hcc duration3c.hcc duration3d.hcc \
       nonlinear1.hcc nonlinear2.hcc typedef1.hcc switch1.hcc switch2.hcc \
       switch-no-matching-case-safe.c switch-no-matching-case-unsafe.c \
       clock-param-int-arg-safe.hcc clock-param-int-arg-unsafe.hcc \
       clock-set-from-variable.hcc \
       clock-heap-field-safe.hcc clock-heap-field-unsafe.hcc"

for name in $TESTS; do
    echo
    echo $name
    $TRI_CMD -cex -abstract:off "$@" $name 2>&1 | grep -v 'at '
done

TESTS="hints.hcc hints2.hcc hints3.hcc"

for opt in -abstract -abstract:manual; do
for name in $TESTS; do
    echo
    echo $name
    $TRI_CMD -cex $opt "$@" $name
done
done

TESTS="interval-propagator-bug.hcc"

for name in $TESTS; do
    echo
    echo $name
    $TRI_CMD -cex -abstract "$@" $name
done

echo
echo hints4.hcc
$TRI_CMD -log:1 -abstract:off "$@" hints4.hcc 2>&1 | grep 'SAFE\|CEGAR iterations'

echo
echo hints-file.c
$TRI_CMD -log:1 -abstract:off -hints:hints-file.hints "$@" hints-file.c 2>&1 | grep 'SAFE\|CEGAR iterations'

TESTS="switch-scoped-decl.hcc switch-scoped-decl-uninit.hcc \
       switch-scoped-decl-init.hcc switch-scoped-decl-fallthrough.hcc"

for name in $TESTS; do
    echo
    echo $name
    $TRI_CMD -abstract:off "$@" $name 2>&1 | grep -E 'SAFE|UNSAFE'
done

TESTS="switch-case-conversion-safe.c switch-case-conversion-unsafe.c"

for name in $TESTS; do
    for mode in math ilp32; do
        echo
        echo "$name ($mode)"
        $TRI_CMD -arithMode:$mode "$@" $name 2>&1 | grep -E '^(SAFE|UNSAFE)$'
    done
done
