#!/bin/sh



TESTS="anon.hcc assign.hcc assign2.hcc assign-exp-eval-order.hcc assign-illegal.hcc \
       init.hcc init-copy-safe.c init-copy-nested-safe.c \
       loop.hcc nested.hcc typedef.hcc emptyStruct.hcc \
       ptr-to-ptr-field-safe.c ptr-to-ptr-field-unsafe.c \
       flexible-array-member.c init-string-char-array.c"

for name in $TESTS; do
    echo
    echo $name
    $TRI_CMD -cex -abstract:off "$@" $name 2>&1 | grep -v 'at '
done

NOCEXTESTS="race.hcc init-copy-unsafe.c init-copy-nested-unsafe.c"
for name in $NOCEXTESTS; do
    echo
    echo $name
    $TRI_CMD -abstract:off "$@" $name 2>&1 | grep -v 'at '
done

TESTS="init-sub-array-zero-safe.c init-sub-array-zero-unsafe.c \
       init-sub-array-next-safe.c init-sub-array-next-unsafe.c \
       init-sub-struct-next-safe.c init-sub-struct-next-unsafe.c \
       init-struct-array-safe.c init-struct-array-unsafe.c \
       grouped-field-declarators-safe.c grouped-field-declarators-unsafe.c"

for name in $TESTS; do
    for mode in math ilp32; do
        echo
        echo "$name ($mode)"
        $TRI_CMD -abstract:off -arithMode:$mode "$@" $name 2>&1 | grep -E '^(SAFE|UNSAFE)$'
    done
done
