TESTS="uchar-wrap-safe.c uchar-wrap-unsafe.c \
       schar-range-safe.c schar-range-unsafe.c \
       char-nondet-range-safe.c char-nondet-range-unsafe.c \
       short-nondet-range-safe.c short-nondet-range-unsafe.c \
       short-assign-conversion-safe.c short-assign-conversion-unsafe.c \
       uchar-ushort-compound-bitwise-safe.c uchar-ushort-compound-bitwise-unsafe.c \
       unsigned-shift-right-safe.c unsigned-shift-right-unsafe.c \
       shift-operand-types-safe.c shift-operand-types-unsafe.c \
       uint-compound-bitwise-safe.c uint-compound-bitwise-unsafe.c \
       literal-hex-int-store-safe.c literal-hex-int-store-unsafe.c"

for name in $TESTS; do
    echo
    echo "$name (ilp32)"
    $TRI_CMD -arithMode:ilp32 "$@" $name 2>&1 | grep -E '^(SAFE|UNSAFE)$'
done

for name in specifier-order-safe.c specifier-order-unsafe.c \
            unsigned-shift-right-safe.c unsigned-shift-right-unsafe.c; do
    echo
    echo "$name (lp64)"
    $TRI_CMD -arithMode:lp64 "$@" $name 2>&1 | grep -E '^(SAFE|UNSAFE)$'
done
